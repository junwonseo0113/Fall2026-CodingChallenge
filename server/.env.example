# Port the API server listens on
PORT=4000

# Optional: connection string for a persistent MongoDB instance
# (MongoDB Atlas free tier, or a local `mongod`).
# If left unset, the server automatically starts an in-memory MongoDB
# instance on boot (via mongodb-memory-server) so the app runs with zero
# database setup -- great for quickly trying the project out, but data
# will NOT persist across server restarts.
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/pinboard

# Secret used to sign JWT auth tokens. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Unsplash API "Access Key" from https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
